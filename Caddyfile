# Caddyfile for Know What I Meme
# Self-signed HTTPS for LAN access
# Access via https://YOUR_SERVER_IP:8444 or https://YOUR_TAILSCALE_IP:8444

{
    https_port 8444
}

# LAN IP
YOUR_SERVER_IP {
    tls internal

    # Socket.io goes directly to backend (avoids double-proxy WebSocket issues)
    handle /socket.io/* {
        reverse_proxy localhost:3002 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # API routes go directly to backend
    handle /api/* {
        reverse_proxy localhost:3002
    }

    # Everything else goes to Vite frontend
    handle {
        reverse_proxy localhost:5173
    }
}

# Tailscale IP
YOUR_TAILSCALE_IP {
    tls internal

    # Socket.io goes directly to backend (avoids double-proxy WebSocket issues)
    handle /socket.io/* {
        reverse_proxy localhost:3002 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # API routes go directly to backend
    handle /api/* {
        reverse_proxy localhost:3002
    }

    # Everything else goes to Vite frontend
    handle {
        reverse_proxy localhost:5173
    }
}

