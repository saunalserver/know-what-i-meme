# Klipy GIF API key (https://klipy.com) — required for GIF search.
KLIPY_API_KEY=your_klipy_api_key_here

# Optional: the public address players should be sent to by the QR code and
# join link, e.g. https://example.com/kwim. Leave it unset to use whatever
# address the host has the game open on (right for LAN / Tailscale play).
# The phone camera used for profile pictures only works over HTTPS.
VITE_PUBLIC_URL=

# Optional: port the server listens on (default 3002).
PORT=3002

# Optional: local GIF pool. Point this at a directory and the server keeps a
# copy of every GIF a search returns, so a LAN party can keep playing when the
# GIF API is unreachable. Unset (the default) means no pool and no downloads.
GIF_CACHE_DIR=
# Optional: how large that pool may grow, in GB (default 5). Least recently
# seen GIFs are evicted once it is full.
GIF_CACHE_MAX_GB=5
